{
  "name": "scribeva-editor",
  "version": "0.0.4",
  "description": "A dependency-free, enterprise-grade HTML editor with a Word-inspired interface.",
  "keywords": [
    "html-editor",
    "rich-text-editor",
    "wysiwyg",
    "typescript",
    "contenteditable",
    "word-editor"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/scribeva.cjs",
  "module": "./dist/scribeva.js",
  "types": "./dist/types/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/public-api.d.ts",
      "import": "./dist/scribeva.js",
      "require": "./dist/scribeva.cjs"
    },
    "./styles.css": "./dist/scribeva.css",
    "./locales": {
      "types": "./dist/types/locales/index.d.ts",
      "import": "./dist/locales.js",
      "require": "./dist/locales.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm run build:site && vite demo --config vite.demo.config.ts",
    "build:site": "vite build --config vite.demo.config.ts && node scripts/prepare-pages.mjs",
    "preview:site": "vite preview --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "cz": "cz",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:verify": "node scripts/verify-docs.mjs",
    "check": "npm run typecheck && npm run test:coverage && npm run docs:verify && npm run build && npm run build:site",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "commitizen": "^4.2.5",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "gsap": "^3.15.0",
    "jsdom": "^24.1.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lian0123/scribeva-editor.git"
  },
  "homepage": "https://github.com/Lian0123/scribeva-editor.#readme",
  "bugs": {
    "url": "https://github.com/Lian0123/scribeva-editor./issues"
  }
}
